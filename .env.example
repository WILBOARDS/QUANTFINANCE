# QuantTerminal: salin file ini menjadi ".env" lalu isi kunci yang kamu punya.
# File .env TIDAK BOLEH di-commit (sudah ada di .gitignore). Kunci hanya dibaca server, tidak pernah dikirim ke browser.

PORT=8787
# 127.0.0.1 = hanya bisa dibuka dari laptopmu sendiri (paling aman). Ganti 0.0.0.0 hanya kalau tahu risikonya.
HOST=127.0.0.1
# Asal (origin) yang boleh memanggil API server ini, dipisah koma. "null" = file HTML dibuka langsung (double-click).
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,null
RATE_LIMIT_PER_MIN=240

# ---- Kapal live global (gratis, daftar pakai akun GitHub): https://aisstream.io/apikeys
AISSTREAM_API_KEY=

# ---- Kapal live Laut Baltik, tanpa kunci (Fintraffic Digitraffic, CC BY 4.0). 1 = aktif, 0 = mati
DIGITRAFFIC_ENABLED=1
DIGITRAFFIC_USER=QuantTerminal/2.0

# ---- Makro AS (gratis): https://fred.stlouisfed.org/docs/api/api_key.html
# Tanpa kunci, server memakai CSV publik FRED (lebih lambat, tetap data asli).
FRED_API_KEY=

# ---- Harga saham AS real-time (gratis, 60 panggilan/menit): https://finnhub.io/register
FINNHUB_API_KEY=

# ---- CoinGecko demo key (opsional, menaikkan batas): https://www.coingecko.com/en/api
COINGECKO_DEMO_KEY=

# ---- Sumber TIDAK RESMI untuk saham non-AS, indeks, dan IDX (mis. BBCA.JK).
# Bisa putus kapan saja dan abu-abu secara ketentuan layanan. 0 = mati (bawaan), 1 = aktif.
ENABLE_UNOFFICIAL_YAHOO=0
